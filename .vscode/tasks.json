{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build ${command:cmake.buildDirectory}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "cpp",
        "source": "clang",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(error|warning|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "select dataset",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/select_dataset.sh ${input:sequence}",
      "problemMatcher": []
    },
    {
      "label": "start rerun",
      "type": "shell",
      "command": "setsid bash -c 'echo $$ > /tmp/livo_rerun.pid; exec rerun --serve-web --port 9877 --web-viewer-port 9091' > /tmp/livo_rerun.log 2>&1 & for i in $(seq 1 40); do curl -sf -o /dev/null http://127.0.0.1:9091/ && break; sleep 0.25; done",
      "problemMatcher": []
    },
    {
      "label": "open viewer",
      "type": "shell",
      "command": "\"$(ls ~/.vscode-server/bin/*/bin/remote-cli/code | head -1)\" --openExternal 'http://127.0.0.1:9091?url=rerun%2Bhttp%3A%2F%2Flocalhost%3A9877%2Fproxy' || true",
      "problemMatcher": []
    },
    {
      "label": "stop rerun",
      "type": "shell",
      "command": "kill -TERM -- -$(cat /tmp/livo_rerun.pid) 2>/dev/null; rm -f /tmp/livo_rerun.pid; true",
      "problemMatcher": []
    },
    {
      "label": "build and start rerun",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build",
        "select dataset",
        "start rerun",
        "open viewer"
      ],
      "problemMatcher": []
    },
    {
      "label": "play bag",
      "type": "shell",
      "command": "setsid ${workspaceFolder}/scripts/play_bag.sh > /tmp/livo_bag.log 2>&1 & sleep 1; echo launched",
      "problemMatcher": []
    },
    {
      "label": "stop bag",
      "type": "shell",
      "command": "kill -TERM -- -$(cat /tmp/livo_bag.pid) 2>/dev/null; rm -f /tmp/livo_bag.pid; true",
      "problemMatcher": []
    },
    {
      "label": "build, start rerun and play bag",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build",
        "select dataset",
        "start rerun",
        "play bag",
        "open viewer"
      ],
      "problemMatcher": []
    },
    {
      "label": "stop rerun and bag",
      "dependsOn": [
        "stop rerun",
        "stop bag"
      ],
      "problemMatcher": []
    },
    {
      "label": "build and select dataset",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build",
        "select dataset"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sequence",
      "type": "pickString",
      "description": "Dataset / sequence",
      "options": [
        "ntu_viral/eee_03_mcap",
        "oxford_spires/2024-05-20-bodleian-library-02",
        "FAST-LIVO2/hku1",
        "FAST-LIVO2/LiDAR_Degenerate"
      ],
      "default": "ntu_viral/eee_03_mcap"
    }
  ]
}
