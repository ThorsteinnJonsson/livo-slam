{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "livo_slam",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/config/active.yaml",
        "-p",
        "ros.bag_path:=${workspaceFolder}/datasets/active"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build and select dataset"
    },
    {
      "name": "livo_slam + rerun",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/config/active.yaml",
        "-p",
        "ros.bag_path:=${workspaceFolder}/datasets/active"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build and start rerun",
      "postDebugTask": "stop rerun"
    },
    {
      "name": "livo_slam + rerun + live playback",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/config/active.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build, start rerun and play bag",
      "postDebugTask": "stop rerun and bag"
    },
    {
      "name": "livo_slam_tests",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/tests/livo_slam_tests",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }
  ]
}
